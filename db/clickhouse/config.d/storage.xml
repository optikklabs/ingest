<clickhouse>
    <storage_configuration>
        <disks>
            <default></default>
        </disks>
        <policies>
            <gcs_only>
                <volumes>
                    <local>
                        <disk>default</disk>
                    </local>
                </volumes>
            </gcs_only>
            <!-- Local development has one disk, so the cold move is a no-op. -->
            <tiered>
                <volumes>
                    <main>
                        <disk>default</disk>
                    </main>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>
